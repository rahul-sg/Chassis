{
  "name": "chassis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "vite",
    "api": "server/.venv/bin/python -m uvicorn garage.app:app --app-dir server --host 127.0.0.1 --port 8311 --reload --reload-dir server/garage",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && server/.venv/bin/python -W ignore server/tests/run.py",
    "phone": "GARAGE_PHONE=1 vite",
    "worker": "cd server && .venv/bin/python -m garage.worker"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@sparkjsdev/spark": "^2.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
